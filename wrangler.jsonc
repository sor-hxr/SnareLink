{
  "name": "snarelink",
  "compatibility_date": "2026-07-23",
  "main": "src/index.ts",
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "link_tracker_db",
      "database_name": "snarelink-db",
      "database_id": "544e4ef4-11b7-462e-9c1d-65dc48c96616"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "075c3a84b024474ea1492783c3daf57e"
    }
  ],
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS"
  }
}